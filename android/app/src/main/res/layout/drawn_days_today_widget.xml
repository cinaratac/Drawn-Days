<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/drawn_days_widget_background"
    android:clipToOutline="true"
    android:padding="12dp">
    <ImageView
        android:id="@+id/widget_doodle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/drawn_days_widget_doodle"
        android:scaleType="fitCenter"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widget_empty_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:contentDescription="@string/drawn_days_widget_draw"
        android:src="@drawable/drawn_days_widget_pencil" />
    <TextView
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:fontFamily="cursive"
        android:textColor="#243E35"
        android:textSize="23sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:ellipsize="end"
        android:fontFamily="cursive"
        android:maxLines="1"
        android:textColor="#68736E"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:fontFamily="cursive"
        android:textColor="#2E6B50"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>
