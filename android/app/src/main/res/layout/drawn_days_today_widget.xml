<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/drawn_days_widget_background"
    android:clipToOutline="true"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_doodle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:contentDescription="@string/drawn_days_widget_doodle"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/drawn_days_widget_draw">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:rotation="-5"
            android:scaleType="fitXY"
            android:src="@drawable/drawn_days_widget_highlight" />

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:contentDescription="@string/drawn_days_widget_draw"
            android:rotation="-7"
            android:src="@drawable/drawn_days_widget_pencil" />
    </FrameLayout>

    <ImageView
        android:id="@+id/widget_day"
        android:layout_width="48dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:contentDescription="@null"
        android:scaleType="fitStart" />

    <ImageView
        android:id="@+id/widget_tape"
        android:layout_width="42dp"
        android:layout_height="10dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-2dp"
        android:contentDescription="@null"
        android:rotation="-3"
        android:scaleType="fitXY"
        android:src="@drawable/drawn_days_widget_tape"
        android:visibility="gone" />

</FrameLayout>
