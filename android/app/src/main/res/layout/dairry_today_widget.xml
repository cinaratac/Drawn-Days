<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dairry_widget_background"
    android:clipToOutline="true"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_doodle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/dairry_widget_doodle"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="✎"
        android:textColor="#315F46"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:textColor="#252925"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#69716A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:textColor="#315F46"
        android:textSize="11sp"
        android:textStyle="bold" />

</FrameLayout>
