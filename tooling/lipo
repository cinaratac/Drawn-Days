#!/bin/sh

set -eu

real_lipo=/usr/bin/lipo

# Flutter 3.44 uses `-extract` even when only one simulator architecture is
# requested. That leaves a single-architecture fat Mach-O which macOS 26.5
# refuses to re-sign when provenance metadata is present. Rewriting that one
# case with `-thin` produces the equivalent normal Mach-O binary.
if [ "$#" -eq 5 ] && [ "$1" = "-output" ] && [ "$3" = "-extract" ]; then
  output_path=$2
  architecture=$4
  input_path=$5

  case "$output_path" in
    *-iphonesimulator/Flutter.framework/Flutter)
      temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/dairry-lipo.XXXXXX")
      temporary_path="$temporary_directory/Flutter"

      trap 'rm -f "$temporary_path"; rmdir "$temporary_directory" 2>/dev/null || true' EXIT HUP INT TERM
      /usr/bin/codesign --remove-signature "$input_path" 2>/dev/null || true
      "$real_lipo" "$input_path" -thin "$architecture" -output "$temporary_path"
      /usr/bin/codesign --force --sign - --timestamp=none "$temporary_path"
      mv "$temporary_path" "$output_path"
      rmdir "$temporary_directory"
      trap - EXIT HUP INT TERM
      exit 0
      ;;
  esac
fi

exec "$real_lipo" "$@"
