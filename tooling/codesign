#!/bin/sh

set -eu

real_codesign=/usr/bin/codesign
target_path=

for argument in "$@"; do
  target_path=$argument
done

# Desktop/iCloud File Provider can attach FinderInfo, provenance and resource
# fork metadata to freshly produced build artifacts. Apple's codesign rejects
# bundles containing that metadata, even for an iOS Simulator ad-hoc signature.
if [ -e "$target_path" ]; then
  /usr/bin/xattr -cr "$target_path" 2>/dev/null || true
fi

# The simulator Flutter engine is signed in a temporary directory by the
# companion lipo wrapper. Re-signing it in place triggers macOS 26.5's
# provenance rejection, so accept the already-valid ad-hoc signature.
case "$target_path" in
  *-iphonesimulator/Flutter.framework/Flutter)
    if "$real_codesign" -d "$target_path" >/dev/null 2>&1; then
      exit 0
    fi
    ;;
  *-iphonesimulator/App.framework/App)
    temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/dairry-codesign.XXXXXX")
    temporary_path="$temporary_directory/App"

    trap 'rm -f "$temporary_path"; rmdir "$temporary_directory" 2>/dev/null || true' EXIT HUP INT TERM
    cp -X "$target_path" "$temporary_path"
    "$real_codesign" --force --sign - --timestamp=none "$temporary_path"
    mv "$temporary_path" "$target_path"
    rmdir "$temporary_directory"
    trap - EXIT HUP INT TERM
    exit 0
    ;;
esac

exec "$real_codesign" "$@"
